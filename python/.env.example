# Oracle connection used by database-backed features.
DB_USER=your_oracle_username
DB_PASSWORD=replace_with_local_password
DB_DSN=your_oracle_dsn

# Safe local default: deterministic Demo Mode.
AI_ASSISTANT_MODE=demo
AI_CATEGORIZATION_MODE=demo

# Optional. Required only when explicitly using OpenAI-backed execution.
OPENAI_API_KEY=
